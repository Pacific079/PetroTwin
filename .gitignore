# ========================================================
# PetroTwin — Git Ignore Configuration
# ========================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment and Secrets (Never commit credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
*.env
!*.env.example

# Production Builds & Packaging
dist/
dist-ssr/
build/
out/
frontend/dist/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Editor & IDE Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary files & Caches
.cache/
.temp/
.tmp/
tmp/
*.bak
scratch/
